# Environment
NODE_ENV=development
PORT=6003



# Security
API_KEY=your_api_key_here


# Service Configuration
LOG_LEVEL=info
OTEL_SERVICE_NAME=credo-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp


# UCO Bank Gateway
UCO_ENABLED=true
UCO_MID=
UCO_TERMINAL_ID=
UCO_EPAY_KEY=
UCO_EPAY_IV=
UCO_PAYMENT_URL=https://epg.ucobank.com/pg/payment
UCO_REQUERY_URL=https://epg.ucobank.com/pg/requery
UCO_CALLBACK_URL=http://localhost:3000/api/v1/callbacks/uco
UCO_TIMEOUT=30000

# SBI ePay Gateway
SBI_ENABLED=true
SBI_MERCHANT_ID=
SBI_AGGREGATOR_ID=SBIEPAY
SBI_ARRAY_KEY=
SBI_PAYMENT_URL=https://merchant.onlinesbi.com/merchant/merchantpay
SBI_SUCCESS_URL=http://localhost:3000/api/v1/callbacks/sbi/success
SBI_FAILURE_URL=http://localhost:3000/api/v1/callbacks/sbi/failure
SBI_DOUBLE_VERIFICATION_URL=https://merchant.onlinesbi.com/merchant/verify
SBI_TIMEOUT=60000

# Canara Bank (BillDesk) Gateway
CANARA_ENABLED=true
CANARA_MERCHANT_ID=
CANARA_CLIENT_ID=
CANARA_SECRET_KEY=
CANARA_PAYMENT_URL=https://pay.billdesk.com/payment
CANARA_CALLBACK_URL=http://localhost:3000/api/v1/callbacks/canara
CANARA_REVERIFICATION_URL=https://pay.billdesk.com/verify
CANARA_TIMEOUT=45000

# Console Gateway (Development Only)
CONSOLE_ENABLED=true
CONSOLE_AUTO_APPROVE=true
CONSOLE_DELAY=2000

# Gateway Device Configuration
GATEWAY_DEVICE_INIT_CHANNEL=internet
GATEWAY_DEVICE_IP=
GATEWAY_DEVICE_ACCEPT_HEADER=text/html
GATEWAY_DEVICE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.0.0 Safari/537.36
