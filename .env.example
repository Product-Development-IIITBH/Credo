# Environment
NODE_ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest


# Service Configuration
LOG_LEVEL=info
OTEL_SERVICE_NAME=credo-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# Email Strategy (smtp | console | ses)
MAIL_STRATEGY=console

# Worker Configuration
MAX_CONCURRENT_JOBS=5
PREFETCH_COUNT=1

# Environment
NODE_ENV=development
SERVICE_NAME=credo
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# API Configuration
API_PREFIX=/api/v1
API_VERSION=1.0.0

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credo_db
DB_USER=credo_user
DB_PASSWORD=credo_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_DIALECT=postgres
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=1800
REDIS_KEY_PREFIX=credo:

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=credo.events
RABBITMQ_QUEUE_SAP=credo.sap.queue
RABBITMQ_QUEUE_RAVEN=credo.raven.queue
RABBITMQ_QUEUE_ANALYTICS=credo.analytics.queue

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_ISSUER=credo

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PAYMENT_INITIATE=5
RATE_LIMIT_STATUS_QUERY=60

# Session
SESSION_TTL=1800

# External Services - SAP
SAP_BASE_URL=http://localhost:4000
SAP_WEBHOOK_URL=http://localhost:4000/webhooks/payment-status
SAP_API_KEY=sap-api-key-change-in-production
SAP_TIMEOUT=10000

# External Services - Raven
RAVEN_BASE_URL=http://localhost:5000
RAVEN_API_KEY=raven-api-key-change-in-production
RAVEN_TIMEOUT=10000

# UCO Bank Gateway
UCO_ENABLED=true
UCO_MID=
UCO_TERMINAL_ID=
UCO_EPAY_KEY=
UCO_EPAY_IV=
UCO_PAYMENT_URL=https://epg.ucobank.com/pg/payment
UCO_REQUERY_URL=https://epg.ucobank.com/pg/requery
UCO_CALLBACK_URL=http://localhost:3000/api/v1/callbacks/uco
UCO_TIMEOUT=30000

# SBI ePay Gateway
SBI_ENABLED=true
SBI_MERCHANT_ID=
SBI_AGGREGATOR_ID=SBIEPAY
SBI_ARRAY_KEY=
SBI_PAYMENT_URL=https://merchant.onlinesbi.com/merchant/merchantpay
SBI_SUCCESS_URL=http://localhost:3000/api/v1/callbacks/sbi/success
SBI_FAILURE_URL=http://localhost:3000/api/v1/callbacks/sbi/failure
SBI_DOUBLE_VERIFICATION_URL=https://merchant.onlinesbi.com/merchant/verify
SBI_TIMEOUT=60000

# Canara Bank (BillDesk) Gateway
CANARA_ENABLED=true
CANARA_MERCHANT_ID=
CANARA_CLIENT_ID=
CANARA_SECRET_KEY=
CANARA_PAYMENT_URL=https://pay.billdesk.com/payment
CANARA_CALLBACK_URL=http://localhost:3000/api/v1/callbacks/canara
CANARA_REVERIFICATION_URL=https://pay.billdesk.com/verify
CANARA_TIMEOUT=45000

# Console Gateway (Development Only)
CONSOLE_ENABLED=true
CONSOLE_AUTO_APPROVE=true
CONSOLE_DELAY=2000

# Cron Jobs
CRON_ENABLED=true
CRON_VERIFICATION_SCHEDULE=*/15 * * * *
CRON_VERIFICATION_DAYS=14
CRON_RECONCILIATION_SCHEDULE=0 2 * * *
CRON_CLEANUP_SCHEDULE=0 3 * * *
CRON_CLEANUP_DAYS=90

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=10000
RETRY_FACTOR=2

# Webhook Configuration
WEBHOOK_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3

# Security
ENCRYPTION_ALGORITHM=aes-256-cbc
HASH_ROUNDS=10

# Monitoring
HEALTH_CHECK_TIMEOUT=5000
METRICS_ENABLED=true