{
  "name": "@iiitbh/credo",
  "version": "1.0.0",
  "description": "Swift, reliable academic payment service for IIIT Bhagalpur",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "seed": "tsx scripts/seed-data.ts",
    "verify-payments": "tsx scripts/verify-stuck-payments.ts",
    "health-check": "tsx scripts/check-health.ts"
  },
  "keywords": [
    "payment",
    "gateway",
    "academic",
    "microservice",
    "express",
    "typescript"
  ],
  "author": "IIIT Bhagalpur",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.52.1",
    "@opentelemetry/auto-instrumentations-node": "0.47.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.52.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.52.1",
    "@opentelemetry/instrumentation": "0.52.1",
    "@opentelemetry/resources": "1.25.1",
    "@opentelemetry/sdk-logs": "0.52.1",
    "@opentelemetry/sdk-metrics": "1.25.1",
    "@opentelemetry/sdk-node": "0.52.1",
    "@opentelemetry/sdk-trace-node": "1.25.1",
    "@opentelemetry/semantic-conventions": "1.25.1",
    "amqplib": "^0.10.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "zod": "^3.22.4",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "sequelize": "^6.35.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    
    "redis": "^4.6.12",
    "ioredis": "^5.3.2",
    "axios": "^1.6.5",

    "uuid": "^9.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.43",
    "crypto-js": "^4.2.0",
    "node-jose": "^2.2.0",
    
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.2.0",
    
    "node-cron": "^3.0.3",
    
    "http-status-codes": "^2.3.0",
    
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/crypto-js": "^4.2.1",
    
    "tsconfig-paths": "^4.2.0",
    
    
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    
    
    "@faker-js/faker": "^8.3.1"
  }
}
